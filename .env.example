# --- Radar UDP input -------------------------------------------------------
UDP_LISTEN_HOST=0.0.0.0
UDP_LISTEN_PORT=13217

# --- AeroSwarm outbound WSS -------------------------------------------------
# Must be wss:// (ws:// is accepted only for localhost, for local testing).
AEROSWARM_INGEST_URL=ws://127.0.0.1:9000/ws/ingest/radar
# Secret. Never logged. Do not commit the real .env.
SOURCE_TOKEN=test-token
FEED_ID=radar-b-test

# --- Reconnect & statistics --------------------------------------------------
# Backoff is fixed at 1s -> 2s -> 4s -> 8s -> 16s -> then capped at this value.
RECONNECT_MAX_MS=30000
STATS_INTERVAL_MS=30000

# --- Optional tuning (defaults shown) ---------------------------------------
# Drop datagrams when the WSS send buffer already holds more than this (slow link).
# MAX_BUFFERED_BYTES=1048576
# WSS ping interval; a missed pong drops the connection and triggers a reconnect.
# PING_INTERVAL_MS=15000
# Requested UDP socket receive buffer. On Linux the OS caps it at net.core.rmem_max
# (a warning is logged if the granted size is smaller than requested).
# UDP_RCVBUF_BYTES=4194304
# debug | info | warn | error
# LOG_LEVEL=info
