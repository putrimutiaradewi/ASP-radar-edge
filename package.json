{
  "name": "@repo/radar-edge",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone edge: raw UDP radar datagrams -> outbound authenticated WSS -> AeroSwarm",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --hot run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir dist",
    "build:exe": "bun build src/index.ts --compile --outfile dist/radar-edge",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "mock:ingest": "bun run scripts/mock-ingest-server.ts",
    "replay:pcap": "bun run scripts/pcap-replay.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  }
}
